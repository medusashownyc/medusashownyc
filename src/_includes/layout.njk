{%- import "macros.njk" as m -%}
{%- set S = cms.settings -%}
{%- set T = cms.strings -%}
{%- set base = '' if isHome else 'index.html' -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title{{ m.es(pageTitleEs, pageTitle) }}>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}"{{ m.esAttr('content', pageDescriptionEs, pageDescription) }}>
<link rel="icon"{% if S.en.favicon and S.en.favicon.endsWith('.svg') %} type="image/svg+xml"{% endif %} href="{{ S.en.favicon }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
</head>
<body>

<span class="scroll-progress" id="scrollProgress" aria-hidden="true"></span>

<header class="site-header" id="siteHeader">
  <div class="site-header-inner wrap">
    <a class="brand" href="{{ '#top' if isHome else 'index.html' }}" aria-label="{{ T.en.home_link }}"{{ m.esAttr('aria-label', T.es.home_link, T.en.home_link) }}>
      <img class="brand-logo brand-logo--light" src="{{ S.en.logo_dark }}" alt="{{ S.en.site_name }}">
      <img class="brand-logo brand-logo--dark" src="{{ S.en.logo_light }}" alt="" aria-hidden="true">
    </a>

    <nav class="main-nav" aria-label="{{ T.en.main_nav }}"{{ m.esAttr('aria-label', T.es.main_nav, T.en.main_nav) }}>
      <ul class="nav-links" id="navLinks">
        <li class="nav-has-mega">
          <a href="{{ base }}#top" data-nav="top"{{ m.es(T.es.nav_shows, T.en.nav_shows) }}>{{ T.en.nav_shows }}</a>
          <div class="nav-mega">
            {%- for show in cms.shows %}
            <a class="nav-mega-item" href="{{ show.url }}" style="--accent: var(--brand-{{ show.en.accent }})">
              <span class="nav-mega-media"><img src="{{ show.en.cover }}" alt=""{% if show.en.crop == 'top' %} style="object-position: 50% 0%"{% endif %}></span>
              <span class="nav-mega-text"{{ m.es(show.es.name, show.en.name) }}>{{ show.en.name }}</span>
            </a>
            {%- endfor %}
          </div>
        </li>
        <li><a href="{{ base }}#about" data-nav="about"{{ m.es(T.es.nav_about, T.en.nav_about) }}>{{ T.en.nav_about }}</a></li>
        <li><a href="{{ base }}#rituales" data-nav="rituales"{{ m.es(T.es.nav_packages, T.en.nav_packages) }}>{{ T.en.nav_packages }}</a></li>
        <li><a href="{{ base }}#testimonials" data-nav="testimonials"{{ m.es(T.es.nav_clients, T.en.nav_clients) }}>{{ T.en.nav_clients }}</a></li>
        <li><a href="{{ base }}#booking" data-nav="booking"{{ m.es(T.es.nav_contact, T.en.nav_contact) }}>{{ T.en.nav_contact }}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="nav-cta" href="#booking" {{ m.cal(S.en.cal_link) }}>
        <span{{ m.es(T.es.book_now, T.en.book_now) }}>{{ T.en.book_now }}</span>
        <span class="nav-cta-badge" aria-hidden="true">
          <img src="{{ S.en.symbol }}" alt="">
        </span>
      </a>
      {{ m.langSwitch() }}
      <button class="nav-toggle" id="navToggle" aria-label="{{ T.en.open_menu }}"{{ m.esAttr('aria-label', T.es.open_menu, T.en.open_menu) }} aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-nav" id="mobileNav">
  <ul class="mobile-nav-links">
    <li><a href="{{ base }}#top"{{ m.es(T.es.nav_shows, T.en.nav_shows) }}>{{ T.en.nav_shows }}</a></li>
    <li><a href="{{ base }}#about"{{ m.es(T.es.nav_about, T.en.nav_about) }}>{{ T.en.nav_about }}</a></li>
    <li><a href="{{ base }}#rituales"{{ m.es(T.es.nav_packages, T.en.nav_packages) }}>{{ T.en.nav_packages }}</a></li>
    <li><a href="{{ base }}#testimonials"{{ m.es(T.es.nav_clients, T.en.nav_clients) }}>{{ T.en.nav_clients }}</a></li>
    <li><a href="{{ base }}#booking"{{ m.es(T.es.nav_contact, T.en.nav_contact) }}>{{ T.en.nav_contact }}</a></li>
  </ul>
  {{ m.langSwitch() }}
  <a class="mobile-nav-cta" href="#booking" {{ m.cal(S.en.cal_link) }}>
    <span{{ m.es(T.es.book_now, T.en.book_now) }}>{{ T.en.book_now }}</span>
    {{ m.arrow() }}
  </a>
</div>

{{ content | safe }}

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand" data-reveal>
      <img src="{{ S.en.logo_light }}" alt="{{ S.en.site_name }}">
      <p{{ m.es(S.es.footer_tagline, S.en.footer_tagline) }}>{{ S.en.footer_tagline }}</p>
    </div>

    <div class="footer-links" data-reveal>
      <h4{{ m.es(T.es.footer_navigation, T.en.footer_navigation) }}>{{ T.en.footer_navigation }}</h4>
      <a href="{{ base }}#top"{{ m.es(T.es.nav_shows, T.en.nav_shows) }}>{{ T.en.nav_shows }}</a>
      <a href="{{ base }}#about"{{ m.es(T.es.nav_about, T.en.nav_about) }}>{{ T.en.nav_about }}</a>
      <a href="{{ base }}#rituales"{{ m.es(T.es.nav_packages, T.en.nav_packages) }}>{{ T.en.nav_packages }}</a>
      <a href="{{ base }}#testimonials"{{ m.es(T.es.nav_clients, T.en.nav_clients) }}>{{ T.en.nav_clients }}</a>
      <a href="#booking"{{ m.es(T.es.book_now, T.en.book_now) }} {{ m.cal(S.en.cal_link) }}>{{ T.en.book_now }}</a>
    </div>

    <div class="footer-contact" data-reveal>
      <h4{{ m.es(T.es.footer_contact, T.en.footer_contact) }}>{{ T.en.footer_contact }}</h4>
      <a href="mailto:{{ S.en.email }}">{{ S.en.email }}</a>
      <a href="https://wa.me/{{ S.en.whatsapp }}" target="_blank" rel="noopener"{{ m.es(T.es.footer_whatsapp, T.en.footer_whatsapp) }}>{{ T.en.footer_whatsapp }}</a>
      {%- if S.en.social.length %}
      <div class="footer-social">
        {%- for link in S.en.social %}
        <a href="{{ link.url }}" target="_blank" rel="noopener" aria-label="{{ m.socialName(link.network) }}">
          {{ m.socialIcon(link.network) }}
        </a>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </div>

  <div class="wrap footer-bottom" data-reveal>
    <span{{ m.es(S.es.copyright, S.en.copyright) }}>{{ S.en.copyright }}</span>
    <button class="back-to-top" id="backToTop" aria-label="{{ T.en.back_to_top }}"{{ m.esAttr('aria-label', T.es.back_to_top, T.en.back_to_top) }}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
  </div>
</footer>

{% if isHome -%}
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>
{% endif -%}
<!-- Plain (non-module) UMD builds, both attaching to window.gsap /
     window.ScrollTrigger — loading GSAP core + ScrollTrigger as separate
     ESM CDN bundles gives each its own private copy of gsap-core, so
     ScrollTrigger never actually connects to the instance the rest of
     the code uses. The UMD builds share one global instance instead. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script type="module" src="i18n.js"></script>
{% if isHome -%}
<script type="module" src="carousel.js"></script>
<script type="module" src="intro.js"></script>
<script type="module" src="experiences.js"></script>
{% endif -%}
<script type="module" src="sections.js"></script>

<!-- Cal element-click embed: any element carrying data-cal-link becomes a
     trigger that opens the booking calendar in a floating modal on click,
     once this loader has run — no inline calendar taking up permanent
     space on the page. The namespace is the event-type slug from the
     "Enlace de Cal.com" setting, so it always matches the triggers. -->
{%- set calNamespace = S.en.cal_link.split('/') | last %}
<script type="text/javascript">
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
  Cal("init", "{{ calNamespace }}", {origin:"https://app.cal.com"});
  Cal.ns["{{ calNamespace }}"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
</script>

</body>
</html>
